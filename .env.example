# Token from @BotFather. Never share or commit it.
BOT_TOKEN=
# The kdrama_heaven channel: @username or numeric -100... id
CHANNEL_ID=@kdrama_heaven
# Comma-separated Telegram user ids allowed to use admin commands (get yours from @userinfobot)
ADMIN_IDS=
TIMEZONE=Asia/Kolkata
# Daily "New episodes today" digest time (HH:MM, in TIMEZONE)
DAILY_DIGEST_TIME=10:00
# Auto-cleanup removes the bot's service notices older than this many days
CLEANUP_DAYS=7
CLEANUP_TIME=03:30
DATABASE_URL=sqlite:///kdrama.db
# Storage: local (SQLite file only) or telegram (DB + posters mirrored to a private channel; use on Koyeb)
STORAGE_BACKEND=local
# Private channel where the bot keeps the pinned DB backup and posters (bot must be admin). Falls back to CHANNEL_ID.
STORAGE_CHANNEL_ID=
# Seconds to wait after the last write before uploading the backup
STORAGE_FLUSH_DELAY=3
# Optional local poster cache dir, e.g. /tmp/posters (empty = off)
POSTER_CACHE_DIR=
